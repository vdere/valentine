# Force proper MIME types for GIFs
<IfModule mod_mime.c>
    AddType image/gif .gif
</IfModule>

# Disable caching for GIFs during development
<IfModule mod_headers.c>
    <FilesMatch "\.(gif)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Mobile-specific GIF headers to force animation
<IfModule mod_headers.c>
    <FilesMatch "\.(gif)$">
        Header set Accept-Ranges "bytes"
        Header set Content-Type "image/gif"
        # Force browsers to not optimize GIFs
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

# Additional mobile browser detection and headers
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Detect mobile browsers and add special headers
    RewriteCond %{HTTP_USER_AGENT} "android|blackberry|googlebot-mobile|iemobile|iphone|ipod|opera mobile|palmos|webos" [NC]
    RewriteRule \.(gif)$ - [E=MOBILE:1]
    
    # Add headers for mobile GIF requests
    Header set Cache-Control "no-cache, no-store, must-revalidate" env=MOBILE
    Header set Pragma "no-cache" env=MOBILE
    Header set Expires "0" env=MOBILE
</IfModule>
